# Copy to .env and fill in to turn on AI mode. Without a key Fineprint runs in offline (no-AI) mode.
# Default provider: NVIDIA Nemotron on Nebius Token Factory (OpenAI-compatible).
NEBIUS_API_KEY=
# Any OpenAI-compatible provider works — override these to swap:
# LLM_API_KEY=
# LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# PORT=3000
